# Copy this file to .env, then add your key from Google AI Studio.
# Never commit the real .env file.
GOOGLE_API_KEY=replace_with_your_key

# Optional in local development; Render generates this secret for deployment.
FLASK_SECRET_KEY=replace_with_a_random_secret
FLASK_COOKIE_SECURE=0

# The stable fallback is attempted once if the primary model remains busy.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
